# ==============================================================================
# adaa | Monorepo Environment Configuration Template
# ==============================================================================
# This template documents all configurable environment variables across the adaa
# monorepo. Never commit actual secret keys or credentials to version control.
# For local backend development, copy this file to backend/.env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Service Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Application Environment (development | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database Connection URI
# Local dev: sqlite:///./wardrobelens.db
# Production (Supabase): postgresql+psycopg2://postgres:<PASSWORD>@<HOST>:5432/postgres
DATABASE_URL=sqlite:///./wardrobelens.db

# File Storage Configuration
# Modes: 'cloudinary' for cloud CDN delivery, or 'local' for offline development
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Supabase Authentication & Identity
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_AUDIENCE=authenticated
# SUPABASE_JWT_SECRET is optional when Supabase asymmetric JWKS is reachable via SUPABASE_URL
SUPABASE_JWT_SECRET=

# Multimodal Fashion Vision Provider (gemini | mock)
# When set to 'gemini', GEMINI_API_KEY is used.
# If no key is set or VISION_PROVIDER=mock, realistic high-fidelity mock results are generated.
VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_TIMEOUT_SECONDS=40

# Virtual Try-On Provider (youcam | mock)
# When YOUCAM_API_KEY is provided, real YouCam S2S API endpoints are invoked.
# When empty or TRYON_PROVIDER=mock, the system uses the mock provider for tests and safe local dev.
TRYON_PROVIDER=mock
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0
TRYON_RETENTION_DAYS=7

# Cloudinary Authenticated Media Delivery (Production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AUTH_TOKEN_KEY=
CLOUDINARY_SECURE_DELIVERY=true
IMAGE_DELIVERY_TTL_SECONDS=1800

# ------------------------------------------------------------------------------
# 2. Flutter Mobile & Web Client Build Configuration (--dart-define)
# ------------------------------------------------------------------------------
# Supply these flags at compile time via flutter run / flutter build:
# Example: flutter run -d chrome --dart-define=API_BASE_URL=http://127.0.0.1:8000
#
# Target Backend API Base URL
# Local Web: http://127.0.0.1:8000
# Local Android Emulator: http://10.0.2.2:8000
# Production Render Service: https://adaa-umsc.onrender.com
API_BASE_URL=http://127.0.0.1:8000

# Optional Demo Account Access (Web showcase only)
# SECURITY NOTE: Injected into client JavaScript bundles; only use curated showcase accounts!
DEMO_EMAIL=
DEMO_PASSWORD=

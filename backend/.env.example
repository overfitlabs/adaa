# WardrobeLens Backend Configuration

# Server
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# AI Vision Provider (gemini | mock)
# When set to 'gemini', GEMINI_API_KEY is used.
# If no key is set or VISION_PROVIDER=mock, realistic high-fidelity mock results are provided.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# YouCam / Perfect Corp Virtual Try-On API
# When YOUCAM_API_KEY is provided, real YouCam S2S API endpoints are invoked.
# When empty or TRYON_PROVIDER=mock, the system uses the mock provider for tests and safe local dev.
TRYON_PROVIDER=mock
YOUCAM_API_KEY=
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com/s2s/v2.0

# Database & Storage
DATABASE_URL=sqlite:///./wardrobelens.db
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# Supabase Auth
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_AUDIENCE=authenticated

# Cloudinary Image Storage (Milestone 2)
# Storage mode: 'cloudinary' for Cloudinary authenticated storage, or 'local' for offline development/tests
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: URL signing token key from Cloudinary Console (Settings -> Security) for CDN token validation
CLOUDINARY_AUTH_TOKEN_KEY=
CLOUDINARY_SECURE_DELIVERY=true
IMAGE_DELIVERY_TTL_SECONDS=1800
TRYON_RETENTION_DAYS=7
